MAX_USB_SIZE_GB=128
DEBIAN_ISO_URL="https://cdimage.debian.org/debian-cd/current/amd64/iso-cd"
SCRIPT_VERSION="2.0"

# Wenn auf "false", fragt der Installer auf dem Zielgerät nach, auf welche Festplatte installiert werden soll.
# WICHTIG: Setze dies auf "false", wenn das ISO über Ventoy gebootet wird, da sonst der gesamte Ventoy-Stick gelöscht wird!
# Wenn auf "true", wird das erste gefundene Laufwerk gnadenlos gelöscht (wie bisher).
AUTO_WIPE_TARGET_DISK=false

# Bietet am Ende des Skripts einen Dialog zur Bereinigung der temporären Dateien an
CLEANUP_PROMPT=true

# Passwoerter fuer die VKS-Installation
# Diese werden als Hash in die preseed.cfg geschrieben
VKS_ROOT_PASSWORD="Master"
VKS_USER_PASSWORD="Kiosk"

# =============================================================
# VM-Test Login Defaults (auto-debug & automated test login)
# =============================================================
VM_KIOSK_USER="Kiosk"
VM_KIOSK_PASSWORD="Kiosk"
VM_ROOT_USER="root"
VM_ROOT_PASSWORD="Master"

# =============================================================
# Local LLM Auto-Debug Settings
# =============================================================
# llama.cpp OpenAI-compatible endpoint (running locally)
LLM_ENDPOINT="http://localhost:8000"
# Best available agentic/reasoning model for auto-debugging
LLM_MODEL="C:\AI-Stack\Models\Hermes-3-Llama-3.1-8B.Q4_K_M.gguf"
LLM_MODEL_PATH="C:/AI-Stack/Models/Hermes-3-Llama-3.1-8B.Q4_K_M.gguf"

# =============================================================
# Appliance Plugins & Extensions Defaults
# =============================================================
ENABLE_VOICE_RECORDING=false
VOICE_RECORDING_FORMAT="wav"
VOICE_RECORDING_PATH="/home/vksuser/Aufzeichnungen"

ENABLE_SIP_PHONE=false
SIP_SERVER="192.168.250.2"
SIP_PORT="5060"
SIP_USER="kiosk_phone"
SIP_PASSWORD=""
